# Shopify (from your Partner dashboard app)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations

# Anthropic — used for supplier extraction and supplier-reply parsing
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
EXTRACTION_MODEL=

# Postgres in production; SQLite file is fine for local dev
DATABASE_URL="file:./prisma/dev.db"
